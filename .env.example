# Microsoft Graph App Registration
# Create an app registration in Azure Portal: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
MICROSOFT_CLIENT_ID=your_client_id_here
MICROSOFT_CLIENT_SECRET=your_client_secret_here
MICROSOFT_TENANT_ID=your_tenant_id_here

# Redirect URI (must be registered in Azure App)
REDIRECT_URI=http://localhost:8000/auth/callback

# Microsoft Graph API Settings
GRAPH_API_ENDPOINT=https://graph.microsoft.com/v1.0

# Required Microsoft Graph Scopes
# For reading emails, calendar, and Teams chats
SCOPES=User.Read,Mail.Read,Calendars.Read,Chat.Read,User.ReadBasic.All

# Database
DATABASE_URL=sqlite:///./passivedata.db

# Application Settings
SECRET_KEY=your_secret_key_here_change_in_production
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Data Export Settings
MAX_EMAILS_PER_USER=1000
MAX_CALENDAR_EVENTS_PER_USER=1000
MAX_CHAT_MESSAGES_PER_USER=1000
DATA_RETENTION_DAYS=90
